# ── 人格运行时（/data/persona/.env，权限 600）────────────────────────
DEEPSEEK_API_KEY=

# ── 感知层（/data/qqbot/.env）────────────────────────────────────────
ONEBOT_ACCESS_TOKEN=
BOT_QQ=<BOT_QQ>
BOT_NICKNAME=Persona

# ── 多模态（/data/qqbot/config/mimo.key，权限 600）───────────────────
MIMO_API_KEY=

# ── 她的运行时环境（compose environment）──────────────────────────────
PERSONA_PROMPT_FILE=/persona/prompts/persona-v2.0-draft.md
PERSONA_MEMORY_FILE=/persona/memory/persona-memory.md
PERSONA_TRIGGERS_FILE=/persona/triggers.yaml
PERSONA_BRIDGE_PORT=13101
PERSONA_OWNER_QQ=<OWNER_QQ>

# NapCat 实际登录账号（必填；请通过部署环境注入）
NAPCAT_ACCOUNT=<BOT_QQ>

# 排障路由（默认 0；仅本地临时开）
FISHTANK_DEBUG_ROUTES=0

# ── 决策桥/P2 可调参数（不设则用代码默认）──────────────────────────
FISHTANK_BRIDGE_PORT=13101
FISHTANK_BRIDGE_BIND=0.0.0.0
FISHTANK_BRIDGE_CONCURRENCY=2
FISHTANK_BRIDGE_TIMEOUT_MS=45000
FISHTANK_MAX_MESSAGES=20
FISHTANK_MAX_MESSAGE_CHARS=200
FISHTANK_BRIDGE_MAX_BODY_BYTES=262144
FISHTANK_MEDIA_MAX_BYTES=31457280

# ── 感知层可调参数（可选）─────────────────────────────────────────
FISHTANK_BILI_PROXY=http://172.18.0.1:13120
FISHTANK_BILI_CACHE_TTL_S=1800
FISHTANK_BILI_BROWSER_TIMEOUT_S=20
FISHTANK_BILI_BRIEF_BUDGET_S=20
FISHTANK_INTERACT_MAX_TIMES=20
FISHTANK_INTERACT_MAX_SPAN_S=3600
FISHTANK_INTERACT_MAX_JOBS=20
FISHTANK_INTERACT_MIN_INTERVAL_S=3
FISHTANK_INTERACT_MIN_GAP_S=3
FISHTANK_TRIGGER_REFRESH_S=60
FISHTANK_ROSTER_INTERVAL_S=21600
FISHTANK_ROSTER_MEMBERS_PER_GROUP=12
FISHTANK_MEDIA_BATCH_LIMIT=24
FISHTANK_MEDIA_PREFETCH_LIMIT=12
FISHTANK_MEDIA_PROMPT_LIMIT=24

# TTS（MiMo，复用 mimo.key）
FISHTANK_TTS_MODEL=mimo-v2.5-tts
FISHTANK_TTS_VOICE=冰糖
FISHTANK_TTS_STYLE=温柔、轻快、有点俏皮的女仆语气。
FISHTANK_TTS_MAX_CHARS=500
FISHTANK_RECALL_MAX_AGE_S=120
