# ── 人格运行时（/data/persona/.env，权限 600）────────────────────────
DEEPSEEK_API_KEY=

# ── 感知层（/data/qqbot/.env）────────────────────────────────────────
ONEBOT_ACCESS_TOKEN=
BOT_QQ=<BOT_QQ>
BOT_NICKNAME=Persona

# ── 多模态（/data/qqbot/config/mimo.key，权限 600）───────────────────
MIMO_API_KEY=

# ── 她的运行时环境（compose environment）──────────────────────────────
PERSONA_PROMPT_FILE=/persona/prompts/persona-v2.0-draft.md
PERSONA_MEMORY_FILE=/persona/memory/persona-memory.md
PERSONA_TRIGGERS_FILE=/persona/triggers.yaml
PERSONA_BRIDGE_PORT=13101
PERSONA_OWNER_QQ=<OWNER_QQ>

# NapCat 实际登录账号（必填；请通过部署环境注入）
NAPCAT_ACCOUNT=<BOT_QQ>

# 排障路由（默认 0；仅本地临时开）
FISHTANK_DEBUG_ROUTES=0
