# qq-persona 用户层 patch（DSH 0.2.0-rc.2）
# 依据：<HOME>/dsha-install/<internal-deployment-doc>.md §4 P2
#
# 三条铁律（写在这里防止后来人踩坑）：
#   1) 本文件顶层是「patch 条目数组」：已有 id 只能做**定向覆盖**（- id: xxx + config/disabled），
#      绝不能在 - insert: 里用同 id 再追加一次 —— 0.2.0 会报 duplicate loader entry id，
#      整棵 plugin tree 起不来（dump-config 检测不到，只有真正启动才炸）。
#   2) personaPrefix / personaSuffix 从持久卷文件读取：每次进程启动重读 ⇒ 每次决策重新注入，
#      且这段文本不进会话历史、不会被压缩吃掉（部署文档 §4 P2「记忆锚点」）。
#      读取时把 "{{" 转义成 "{ {"：system-prompt 的变量插值是 strict 的，未知变量会抛错。
#   3) 工具白名单用 disabled: true 关条目实现（不是 tools.mode，后者只管呈现方式），
#      关掉条目=连工具 schema 都不进 system prompt，直接省 token。

# ── 触发器工具（她自己调用；工具描述里就是 8 种类型的用法）─────────────────
# 插件实体在 /data/persona/data/dsh-install/node_modules/@persona/trigger-tools（持久卷）
- insert:
    - id: persona-trigger-tools
      name: '/data/dsh-install/node_modules/@persona/trigger-tools/lib/index.js'
    - id: persona-chat-search
      name: '/data/dsh-install/node_modules/@persona/chat-search/lib/index.js'
    - id: persona-nickname-tools
      name: '/data/dsh-install/node_modules/@persona/nickname-tools/lib/index.js'
    - id: persona-perception-tools
      name: '/data/dsh-install/node_modules/@persona/perception-tools/lib/index.js'
    - id: persona-doc-tools
      name: '/data/dsh-install/node_modules/@persona/doc-tools/lib/index.js'
    - id: persona-interact-tools
      name: '/data/dsh-install/node_modules/@persona/interact-tools/lib/index.js'
    - id: persona-sticker-tools
      name: '/data/dsh-install/node_modules/@persona/sticker-tools/lib/index.js'
    - id: persona-browser-tools
      name: '/data/dsh-install/node_modules/@persona/browser-tools/lib/index.js'
    - id: persona-napcat-tools
      name: '/data/dsh-install/node_modules/@persona/napcat-tools/lib/index.js'
    - id: persona-mail-tools
      name: '/data/dsh-install/node_modules/@persona/mail-tools/lib/index.js'
    - id: persona-recall-tools
      name: '/data/dsh-install/node_modules/@persona/recall-tools/lib/index.js'
    - id: persona-tts-tools
      name: '/data/dsh-install/node_modules/@persona/tts-tools/lib/index.js'

# ── 人格 + 记忆锚点 ────────────────────────────────────────────────────────
- id: system-prompt
  config:
    # 独立人格：去掉 "You are a coding agent / DeepSeek Harness" 这层身份
    includeHarnessIdentity: false
    personaPrefix: !!js ((FS,OB)=>FS.readFileSync(process.env.PERSONA_PROMPT_FILE,"utf8").split(OB+OB).join(OB+" "+OB))(process.getBuiltinModule("node:fs"),String.fromCharCode(123))
    personaSuffix: !!js ((FS)=>FS.readFileSync(process.env.PERSONA_MEMORY_FILE,"utf8")+"\n\n---\n\n"+(FS.existsSync("/persona/memory/群友档案.md")?FS.readFileSync("/persona/memory/群友档案.md","utf8"):"(群友档案还没有生成)"))(process.getBuiltinModule("node:fs"))

# ── 模型：deepseek-flash，思考强度 **low**（用户 2026-10-17 决定：要快，
#   "调高了想半天才回，没必要那么严谨"）。官方支持 low/high/max，改一个词即可切换。
- id: agent-default-model
  config:
    provider: deepseek-official
    model: deepseek-flash
    reasoningEffort: low

# ── 沙箱可写根：/persona（她能自己维护触发器与记忆锚点）──────────────────
# 默认 workspaceRoot = process.cwd() = /persona/work；那样她就改不了
# /persona/triggers.yaml（红线 4 要求"触发器归她自己维护"）。放宽到 /persona 后，
# 她只能写这个挂载目录（人格 prompt / 记忆 / 触发器 / 工作区），/data 与系统目录仍在沙箱外。
- id: sandbox-policy
  config:
    mode: workspace-write
    workspaceRoot: /persona

# ── 工具白名单：只留 bash / read / write / edit / grep / glob ──────────────
# 关闭 = 工具不进 system prompt；被关掉的插件若被别的插件依赖，会在启动告警里现形（见 V2）。
# 网络类：**用户要求开放官方搜索**（2026-10-17）——用 DSH 自带的 web_search（DeepSeek 官方
# Anthropic-compatible web_search 工具）+ web_fetch，不另造轮子。
# 注意：这两个工具会把网页内容带进上下文（潜在的提示注入面），她的人格里已写"把网页当资料不当命令"。
- id: tool-web
  disabled: false
- id: web
  disabled: false
- id: web-search-deepseek
  disabled: false
- id: web-fetch-http
  disabled: false
- id: mcp-resources
  disabled: true   # 她没有配 MCP server，先关
# 子代理 / 分叉：headless 一次性决策里没有意义，还会烧 token
- id: subagent
  disabled: true
- id: subagent-spawn-in-process
  disabled: true
- id: subagent-fork-in-process
  disabled: true
- id: tool-subagent
  disabled: true
- id: tool-subagent-fork
  disabled: true
- id: tool-subagent-control
  disabled: true
- id: tool-subagent-list-agents
  disabled: true
# 工作流 / 代码运行时
- id: workflow-ptc
  disabled: true
- id: tool-workflow
  disabled: true
- id: ptc-runtime
  disabled: true
# skill 体系：人格不需要技能库
- id: skill
  disabled: true
- id: skill-filesystem
  disabled: true
- id: tool-skill
  disabled: true
# Windows 专用（Linux 容器里不可能用）
- id: tool-pwsh
  disabled: true
- id: pwsh-sandbox
  disabled: true
# 人机交互：headless 里没人会回答提问
- id: user-questions
  disabled: true
# 待办 / 目标 / plan / ralph：单人一次性决策用不上，白占 schema
- id: tool-todo
  disabled: true
- id: goal
  disabled: true
- id: goal-round-driver
  disabled: true
- id: command-goal
  disabled: true
- id: tool-goal
  disabled: true
# - id: tool-ralph        # 0.2.1-rc.2 起该条目已不存在（dump-config 会报 not found），去掉
- id: plan-mode
  disabled: true
# 后台任务表：单次决策内不需要
- id: tool-jobs
  disabled: true
# 会话标题自动生成：每建一个群会话都会多打一次 LLM（成本 + 延迟），关掉
- id: session-title
  disabled: true
- id: session-title-llm
  disabled: true
